<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Warlords</AssemblyName>
    <Version>0.4.0</Version>
    <ApplicationIcon>Assets/warlords.ico</ApplicationIcon>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets/warlords-logo.png;Assets/warlords.ico;Assets/NOTICE.md" />
    <Resource Include="Assets/warlords-logo.png" />
    <Resource Include="Assets/warlords.ico" />
    <Resource Include="Assets/NOTICE.md" />
  </ItemGroup>
</Project>
