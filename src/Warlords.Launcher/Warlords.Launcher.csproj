<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Warlords</AssemblyName>
    <Version>0.5.4</Version>
    <ApplicationIcon>Assets/warlords.ico</ApplicationIcon>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets/warlords-logo.png;Assets/warlords.ico;Assets/NOTICE.md;Assets/hero.jpg" />
    <Resource Include="Assets/warlords-logo.png" />
    <Resource Include="Assets/warlords.ico" />
    <Resource Include="Assets/NOTICE.md" />
    <Resource Include="Assets/hero.jpg" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>
  <!-- Keep one exe: self-update swaps exactly one file. Net48.cs loads these at run time. -->
  <Target Name="EmbedLibraries" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" LogicalName="lib/%(Filename)%(Extension)" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
</Project>
