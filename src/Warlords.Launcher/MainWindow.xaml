<Window x:Class="Warlords.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warlords" Width="980" Height="730" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Surface}" Padding="26,34">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Windows / Steam" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
          <Button x:Name="LogsButton" Content="Open _logs" Click="OpenLogs_Click" HorizontalContentAlignment="Left"/>
          <TextBlock Text="Launcher 0.2.1 · unsigned test build" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Warlords" FontFamily="Georgia" FontSize="33" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="Your next battle starts here." Margin="0,12,0,34" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="StratLords" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Closed testing" Margin="0,6,0,0" Foreground="{StaticResource Muted}"/>
          <Separator Margin="0,28,0,22" Background="#526052"/>
          <TextBlock Text="Requirements" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="Bannerlord 1.4.8&#10;Armory 1.0.0.17" LineHeight="23" Foreground="{StaticResource Muted}"/>
          <Button Content="Get _Armory" Click="Armory_Click" Margin="0,18,0,0"/>
          <TextBlock Text="Every tester needs the same client build and an approved test server." Margin="0,26,0,0" Foreground="{StaticResource Muted}" FontSize="13"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="34,32,34,28">
        <TextBlock Text="Ready your company." FontFamily="Georgia" FontSize="31" Margin="0,0,0,8"/>
        <TextBlock Text="Warlords checks for the latest StratLords build and keeps your installation up to date." Foreground="{StaticResource Muted}" Margin="0,0,0,28"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Bannerlord folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="DetectButton" Content="_Detect" Click="Detect_Click" MinHeight="30" Padding="12,4"/>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="GameRootBox" AutomationProperties.Name="Bannerlord installation folder" ToolTip="Select the Mount &amp; Blade II Bannerlord folder that contains Modules and bin." LostKeyboardFocus="GameRoot_LostKeyboardFocus"/>
          <Button Grid.Column="1" x:Name="BrowseButton" Content="_Browse" Click="Browse_Click" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock x:Name="GameStatusText" Text="Looking for Bannerlord…" Foreground="{StaticResource Muted}" Margin="0,10,0,24"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Latest build" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="ChoosePackButton" Content="Choose test _pack" Click="ChoosePack_Click" MinHeight="32" Padding="12,5"/>
        </Grid>
        <TextBlock x:Name="ReleaseText" Text="Checking for updates…" FontSize="16"/>
        <TextBlock x:Name="SourceText" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <TextBlock x:Name="ChannelSourceText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
        <TextBlock x:Name="ExpiryText" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button x:Name="RefreshButton" Content="Check for _updates" Click="Refresh_Click" Margin="0,0,10,0"/>
          <Button x:Name="BranchButton" Content="Check source branch" Click="Branch_Click"/>
        </StackPanel>
        <TextBlock x:Name="BranchStatusText" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <Expander Header="Automatic update channel" Foreground="{StaticResource Muted}" Margin="0,18,0,0">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="The public update channel is built in. Change this only if your host gives you a different channel." Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="ChannelUrlBox" AutomationProperties.Name="HTTPS update channel URL"/>
              <Button Grid.Column="1" x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Margin="10,0,0,0"/>
            </Grid>
          </StackPanel>
        </Expander>
        <Separator Margin="0,22,0,20" Background="#526052"/>
        <TextBlock x:Name="OperationText" Text="Checking for the latest build…" Margin="0,0,0,10"/>
        <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Background="#34453D" Foreground="{StaticResource Accent}" Margin="0,0,0,18"/>
        <WrapPanel>
          <Button x:Name="InstallButton" Content="_Install / Update" Click="Install_Click" Background="{StaticResource Accent}" Foreground="#151B19" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" MinWidth="164" Margin="0,0,10,8"/>
          <Button x:Name="VerifyButton" Content="_Verify files" Click="Verify_Click" Margin="0,0,10,8"/>
          <Button x:Name="PlayButton" Content="_Play" Click="Play_Click" MinWidth="95" Margin="0,0,10,8"/>
          <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="In Bannerlord's launcher: Multiplayer → Native, Multiplayer, Armory, Warlords → Play." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
        <Expander Header="Activity" Foreground="{StaticResource Muted}" Margin="0,18,0,0">
          <TextBox x:Name="ActivityBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" FontSize="12" AutomationProperties.Name="Launcher activity log"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
