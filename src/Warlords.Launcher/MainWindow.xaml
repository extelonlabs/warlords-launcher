<Window x:Class="Warlords.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warlords" Icon="Assets/warlords.ico" Width="900" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Startup animation. Visual only: started on Loaded after the setup check has begun; a click or key skips it. -->
    <Storyboard x:Key="SplashStoryboard">
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay" Storyboard.TargetProperty="Visibility">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
        <DiscreteObjectKeyFrame KeyTime="0:0:1.0" Value="{x:Static Visibility.Collapsed}"/>
      </ObjectAnimationUsingKeyFrames>
      <BooleanAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay" Storyboard.TargetProperty="IsHitTestVisible">
        <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
        <DiscreteBooleanKeyFrame KeyTime="0:0:1.0" Value="False"/>
      </BooleanAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.75" Value="1"/>
        <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashCrest" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashCrest" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.85"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashCrest" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.85"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashWordmark" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashLine" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainContent" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.75" Value="0"/>
        <EasingDoubleKeyFrame KeyTime="0:0:1.05" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.75" Value="14"/>
        <EasingDoubleKeyFrame KeyTime="0:0:1.05" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleBrand" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.75" Value="0"/>
        <EasingDoubleKeyFrame KeyTime="0:0:1.05" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <!-- Very slow drift on the art. Low frame rate: it should not cost anything while the game runs. -->
    <Storyboard x:Key="HeroDrift" Timeline.DesiredFrameRate="15">
      <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.07" Duration="0:0:40" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.07" Duration="0:0:40" AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>
  </Window.Resources>
  <Border x:Name="WindowFrame" Background="{StaticResource CanvasVignette}" BorderBrush="#2C3833" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- The art sits behind the title bar and the top of the page, and fades into the window colour. -->
      <Grid x:Name="HeroLayer" Grid.RowSpan="2" Height="500" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
        <Image x:Name="HeroArt" Source="Assets/hero.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Warlords art">
          <Image.RenderTransform><ScaleTransform x:Name="HeroScale"/></Image.RenderTransform>
        </Image>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#66111614" Offset="0"/>
              <GradientStop Color="#18111614" Offset="0.55"/>
              <GradientStop Color="#00111614" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#99111614" Offset="0"/>
              <GradientStop Color="#00151B19" Offset="0.22"/>
              <GradientStop Color="#00151B19" Offset="0.42"/>
              <GradientStop Color="#99151B19" Offset="0.72"/>
              <GradientStop Color="#FF151B19" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel x:Name="MainContent" Margin="28,0,28,20">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
          <!-- Hero: what is happening on the left, the one thing to press on the right. -->
          <Grid x:Name="HeroBlock" MinHeight="320">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,24,0">
              <StackPanel Orientation="Horizontal">
                <ContentControl x:Name="StatusBadge" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="Status icon"/>
                <TextBlock x:Name="StatusTitleText" Text="Getting things ready" FontFamily="Georgia" FontSize="36" LineHeight="44" VerticalAlignment="Center" TextWrapping="NoWrap">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#000000"/></TextBlock.Effect>
                </TextBlock>
              </StackPanel>
              <TextBlock x:Name="StatusHintText" Text="We’ll find your game and check for the latest Warlords update." Margin="0,8,0,0">
                <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="#000000"/></TextBlock.Effect>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button x:Name="CancelButton" Content="_Cancel" Click="Cancel_Click" IsEnabled="False" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="PrimaryButton" Content="Getting ready…" Click="Primary_Click" Style="{StaticResource PrimaryButtonStyle}" MinHeight="58" MinWidth="224" FontSize="18" VerticalAlignment="Center" AutomationProperties.HelpText="The next step for this Warlords installation"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
              <Border x:Name="OperationRow" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="OperationText" Text="Checking the latest build…" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
                  <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Grid>
              </Border>
              <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Background="#2A3330" Foreground="{StaticResource Accent}" BorderThickness="0" Margin="0,8,0,0" AutomationProperties.Name="Current operation progress"/>
              <TextBlock x:Name="ProgressDetailText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>
              <!-- Live steps of an install or launcher update, in plain words. Stays until the next action. -->
              <Border x:Name="StepsBox" Background="#D90E1311" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10,14,12" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="What the launcher is doing" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                  <StackPanel x:Name="StepsList" TextElement.FontFamily="Consolas" TextElement.FontSize="13" AutomationProperties.Name="Install steps"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Expander x:Name="SetupExpander" Header="Checking your setup" Style="{StaticResource SettingsExpanderStyle}" Margin="0,18,0,0">
            <Grid Margin="-4,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="GameStepCard" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ContentControl x:Name="GameStepBadge" Style="{StaticResource StepBadge}" Content="1" Margin="0,0,10,0" AutomationProperties.Name="Step 1"/>
                    <TextBlock Text="Bannerlord" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock x:Name="GameStatusText" Text="Looking for your Steam installation…" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Text, ElementName=GameRootBox}" ToolTip="{Binding Text, ElementName=GameRootBox}" Foreground="{StaticResource Muted}" Opacity="0.8" FontSize="12" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button x:Name="BrowseButton" Grid.Row="2" Content="Choose _folder" Click="Browse_Click" HorizontalAlignment="Left" Margin="-14,8,0,-6" Style="{StaticResource QuietButton}" AutomationProperties.Name="Choose Bannerlord folder"/>
                </Grid>
              </Border>
              <Border x:Name="ArmoryStepCard" Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ContentControl x:Name="ArmoryStepBadge" Style="{StaticResource StepBadge}" Content="2" Margin="0,0,10,0" AutomationProperties.Name="Step 2"/>
                    <TextBlock Text="Armory" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="ArmoryStatusText" Grid.Row="1" Text="Checking the required Workshop mod…" Foreground="{StaticResource Muted}"/>
                  <Button x:Name="ArmoryButton" Grid.Row="2" Content="Get _Armory" Click="Armory_Click" HorizontalAlignment="Left" Margin="-14,8,0,-6" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open Warlords Armory in Steam Workshop"/>
                </Grid>
              </Border>
              <Border x:Name="WarlordsStepCard" Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ContentControl x:Name="WarlordsStepBadge" Style="{StaticResource StepBadge}" Content="3" Margin="0,0,10,0" AutomationProperties.Name="Step 3"/>
                    <TextBlock Text="Warlords" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock x:Name="ReleaseText" Text="Checking for updates…"/>
                    <TextBlock x:Name="InstallStateText" Text="Your installation will stay up to date automatically." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button x:Name="RefreshButton" Grid.Row="2" Content="Check _again" Click="Refresh_Click" HorizontalAlignment="Left" Margin="-14,8,0,-6" Style="{StaticResource QuietButton}" AutomationProperties.Name="Check the game and update again"/>
                </Grid>
              </Border>
            </Grid>
          </Expander>
          <!-- News: the newest changes, shown without opening anything. Hidden when notes can't be loaded. -->
          <Border x:Name="NewsCard" Style="{StaticResource Card}" Padding="18,14" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="NewsTitleText" Style="{StaticResource SectionLabel}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0"/>
              <Button x:Name="NewsAllButton" Grid.Column="1" Content="Read _all" Click="NewsAll_Click" Style="{StaticResource QuietButton}" MinHeight="30" Padding="10,4" Margin="0,-4,-8,-4" AutomationProperties.Name="Read all release notes"/>
              <TextBlock x:Name="NewsItemsText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            </Grid>
          </Border>
          <Expander x:Name="ChangelogExpander" Header="All release notes" Expanded="Changelog_Expanded" Style="{StaticResource SettingsExpanderStyle}" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ChangelogStatusText" Text="Open this section to read the latest changes." Foreground="{StaticResource Muted}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
              <TextBox x:Name="ChangelogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Warlords release notes">
                <!-- Only the page scrolls; hide the empty box so no gap is left. -->
                <TextBox.Style>
                  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <Button x:Name="ChangelogRetryButton" Content="_Retry release notes" Click="ChangelogRetry_Click" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="-14,0,0,0"/>
            </StackPanel>
          </Expander>
          <Expander x:Name="SettingsExpander" Header="Settings &amp; help" Style="{StaticResource SettingsExpanderStyle}" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="Bannerlord folder" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="Usually found automatically. Choose the Steam game folder if you need to change it." Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="GameRootBox" AutomationProperties.Name="Bannerlord installation folder" ToolTip="The Steam Bannerlord folder containing Modules and bin." LostKeyboardFocus="GameRoot_LostKeyboardFocus"/>
                <Button x:Name="DetectButton" Grid.Column="1" Content="_Find automatically" Click="Detect_Click" Margin="10,0,0,0"/>
              </Grid>
              <TextBlock Text="Troubleshooting" Style="{StaticResource SectionLabel}" Margin="0,24,0,4"/>
              <TextBlock Text="Check your files, reinstall Warlords, or open the logs to share when you report a problem." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
              <WrapPanel>
                <Button x:Name="VerifyButton" Content="_Verify files" Click="Verify_Click" Margin="0,0,8,8"/>
                <Button x:Name="InstallButton" Content="_Reinstall / repair" Click="Install_Click" Margin="0,0,8,8"/>
                <Button x:Name="LogsButton" Content="Open _logs" Click="OpenLogs_Click" Margin="0,0,8,8"/>
                <Button x:Name="ChoosePackButton" Content="Choose test _pack" Click="ChoosePack_Click" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock Text="When Steam opens, choose Multiplayer and enable Native, Multiplayer, Armory and Warlords, then Play." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="SplashOverlay" Grid.Row="1" Background="{StaticResource CanvasVignette}" Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
          <Image x:Name="SplashCrest" Source="Assets/warlords-logo.png" Width="112" Height="112" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Warlords crest">
            <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
          </Image>
          <TextBlock x:Name="SplashWordmark" Text="Warlords" FontFamily="Georgia" FontSize="40" LineHeight="50" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
          <Rectangle x:Name="SplashLine" Height="2" Width="180" Fill="{StaticResource AccentRule}" Margin="0,8,0,0" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform>
          </Rectangle>
        </StackPanel>
      </Grid>
      <!-- Title bar. Declared last so caption buttons come last in Tab order. -->
      <Border x:Name="TitleBar" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="TitleBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <Image Source="Assets/warlords-logo.png" Width="44" Height="44" Stretch="Uniform" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Warlords crest"/>
            <TextBlock Text="Warlords" FontFamily="Georgia" FontSize="27" LineHeight="34" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
            <Button x:Name="WebsiteButton" Style="{StaticResource TitleIconButton}" Click="Website_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Website" AutomationProperties.Name="Open the StratLords website">
              <Path Style="{StaticResource TitleIconLine}" Data="M 7,0.5 A 6.5,6.5 0 1 1 6.99,0.5 Z M 0.5,7 L 13.5,7 M 7,0.5 C 3.6,4 3.6,10 7,13.5 M 7,0.5 C 10.4,4 10.4,10 7,13.5"/>
            </Button>
            <Button x:Name="DiscordButton" Style="{StaticResource TitleIconButton}" Click="Discord_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Discord" AutomationProperties.Name="Join the StratLords Discord" Margin="4,0,0,0">
              <Path Style="{StaticResource TitleIconFill}" Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
            </Button>
            <Button x:Name="GitHubButton" Style="{StaticResource TitleIconButton}" Click="GitHub_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="GitHub" AutomationProperties.Name="Open the Warlords launcher on GitHub" Margin="4,0,0,0">
              <Path Style="{StaticResource TitleIconFill}" Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </Button>
            <Button x:Name="LauncherUpdateButton" Style="{StaticResource LauncherUpdateButton}" Click="UpdateLauncher_Click" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Download, check and install the newer Warlords launcher" AutomationProperties.Name="Update the Warlords launcher" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource TitleLinkIcon}" Data="M 7,0.5 L 7,9.5 M 3,5.5 L 7,9.5 L 11,5.5 M 1,13.5 L 13,13.5"/>
                <TextBlock x:Name="LauncherUpdateText" Text="Update launcher" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" LineHeight="18" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="LauncherVersionText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" AutomationProperties.Name="Minimize">
              <Path Style="{StaticResource CaptionGlyph}" Data="M 0,5.5 L 10,5.5"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" AutomationProperties.Name="Maximize">
              <Grid>
                <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"/>
                <Path x:Name="RestoreGlyph" Style="{StaticResource CaptionGlyph}" Data="M 2.5,2.5 L 2.5,0.5 L 9.5,0.5 L 9.5,7.5 L 7.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" AutomationProperties.Name="Close">
              <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
